{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "max_open_trades": 5,
    "stake_currency": "USDT",
    "stake_amount": 200,
    "tradable_balance_ratio": 1,
    "fiat_display_currency": "USD",
    "dry_run": true,
    "timeframe": "5m",
    "dry_run_wallet": 1000,
    "cancel_open_orders_on_exit": true,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 30
    },
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [
            "1INCH/USDT:USDT",
            "ALGO/USDT:USDT",
            "BTC/USDT:USDT"
        ],
        "pair_blacklist": []
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "freqai": {
    "enabled": true,
    "purge_old_models": 2,
    "train_period_days": 15,
    "backtest_period_days": 7,
    "identifier": "Framework_Success_V2",
    "feature_parameters": {
        "include_shifted_candles": 0,
        "include_timeframes": ["5m", "15m"],
        "include_corr_pairlist": ["ETH/USDT:USDT"],
        "label_period_candles": 20,
        "DI_threshold": 100,
        "weight_factor": 0,
        "principal_component_analysis": false,
        "use_SVM_to_remove_outliers": false,
        "indicator_periods_candles": [20]
    },
    "data_split_parameters": {
        "test_size": 0.25,
        "random_state": 42
    },
    "model_training_parameters": {
        "n_estimators": 100,
        "learning_rate": 0.01,
        "max_depth": 5
    }
},
    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "info",
        "jwt_secret_key": "43f8a82736dfdf1e7997dc60f7b77b83265619507401bc4198e9713e6101f1ef",
        "CORS_origins": ["http://freqtrade_elliotwaves:8080","http://freqtrade:8080"],
        "username": "freqtrader",
        "password": "SuperSecurePassword"
    },
    "bot_name": "XGBoostClassifier_v6",
    "force_entry_enable": true,
    "initial_state": "running",
    "internals": {
        "process_throttle_secs": 5
    },
    "telegram": {
        "enabled": true,
        "token": "8612680071:AAGBSF70j1zneVJvmBaW9gW8M1ikC0s-k_Q",
        "chat_id": "8501218611",
        "keyboard": [
          ["/daily", "/stats", "/balance", "/profit"],
          ["/status table", "/performance"],
          ["/reload_config", "/count", "/logs"]
      ]
    }
}
